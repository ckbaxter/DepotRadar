# DepotRadar — Einstellungen (alles optional).
# Zum Verwenden neben die docker-compose.yml kopieren:  cp .env.example .env
# Nach Änderungen:  docker compose up -d

# Zeitzone des Servers
TZ=Europe/Berlin

# Adresse, unter der DepotRadar erreichbar ist (ohne Slash am Ende) — wichtig für Parqet OAuth
# und die Links in Benachrichtigungen. Muss mit der tatsächlich genutzten Adresse übereinstimmen.
APP_URL=http://localhost:8080

# Port auf dem Server, unter dem die Oberfläche erreichbar ist
WEB_PORT=8080

# Kostenloser Key von openfigi.com: 250 statt 25 Anfragen/Minute bei der XETRA-Ticker-Suche
OPENFIGI_API_KEY=

# Admin-Benutzer, durch Komma getrennt (Namen wie im Benutzerprofil)
ADMIN_USERS=

# One-Shot-Variablen: Wert setzen, `docker compose up -d` ausführen, danach wieder leeren
# und erneut `docker compose up -d` ausführen.
RESET_PIN_USER=
DELETE_USER=
